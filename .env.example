# Firebase web app config (Firebase console > Project settings > Your apps)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
# App Check (reCAPTCHA Enterprise site key). Leave empty locally and use a debug token.
VITE_APPCHECK_SITE_KEY=
VITE_APPCHECK_DEBUG_TOKEN=
# Run everything against the local Firebase emulators (no Firebase project needed).
# Start them with: npm run emulators
VITE_USE_EMULATORS=
